  "components": {
    "schemas": {
      "GenerateScenarioRequest": {
        "properties": {
          "concept": {
            "type": "string",
            "title": "Concept"
          }
        },
        "type": "object",
        "required": [
          "concept"
        ],
        "title": "GenerateScenarioRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SessionCheckRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "user_input": {
            "type": "string",
            "title": "User Input"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "user_input"
        ],
        "title": "SessionCheckRequest"
      },
      "TransitionRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "next_act_id": {
            "type": "string",
            "title": "Next Act Id"
          },
          "next_seq_id": {
            "type": "string",
            "title": "Next Seq Id"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "next_act_id",
          "next_seq_id"
        ],
        "title": "TransitionRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "ValidationOutput": {
        "properties": {
          "is_triggered": {
            "type": "boolean",
            "title": "Is Triggered",
            "description": "Whether the transition condition is met"
          },
          "reason": {
            "type": "string",
            "title": "Reason",
            "description": "Reasoning for the decision"
          },
          "next_act_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Act Id"
          },
          "next_seq_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Seq Id"
          },
          "suggested_narration": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Suggested Narration",
            "description": "GM narration for the transition"
          }
        },
        "type": "object",
        "required": [
          "is_triggered",
          "reason"
        ],
        "title": "ValidationOutput"
      },
      "ValidationRequest": {
        "properties": {
          "scenario_id": {
            "type": "string",
            "title": "Scenario Id"
          },
          "act_id": {
            "type": "string",
            "title": "Act Id"
          },
          "seq_id": {
            "type": "string",
            "title": "Seq Id"
          },
          "user_input": {
            "type": "string",
            "title": "User Input"
          }
        },
        "type": "object",
        "required": [
          "scenario_id",
          "act_id",
          "seq_id",
          "user_input"
        ],
        "title": "ValidationRequest"
      }
    }
  }
